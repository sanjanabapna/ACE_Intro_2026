%%clear var
clear all;
close all;
clc;

%%define parameters

%grav acc [m/s^2]
g=9.81;

%surf area [m^2]
S=1.0;

% water density [kg/m^3]
rho=1000;

%loss coeff [Pa s^2/kg^2]
%ToDo: Verify loss coeff units
Cl=1000;

% initial water level [m]
h0=2;

%% calculated parameters

alpha = -sqrt(g/S^2/rho/Cl);
Ci_prime = sqrt(h0);

t_e = -2*sqrt(h0)/alpha;

%%
t_past = linspace(-0.2*t_e, 0);

t0=0;
t1=t_e;
t=linspace(t0,t1, 5001);

h= alpha^2*t.^2/4 + sqrt(h0)*alpha*t + h0;
h_ave = (h0*t_e + alpha^2*t_e^3/12 + alpha*sqrt(h0)*t_e^2/2) / (t_e-t0);

disp({'the numerically computed average height of the water is', mean(h)})
disp({'the analytically computed average height of the water is', mean(h_ave)})

%% visualisations
plot(t,h, '-b')
hold on
plot(t_past, t_past*0 +h0, '-r')
plot(t, t*0+h_ave, '--g')
xlim([-0.2*t_e, t_e])
ylim([0,1.05*h0])
xlabel('t [s]')
ylabel('h [m]')
